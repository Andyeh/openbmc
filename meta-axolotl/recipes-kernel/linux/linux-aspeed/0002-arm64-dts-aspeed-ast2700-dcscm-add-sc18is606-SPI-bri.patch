From 3da64e327e2fd8ea6d35c7a5c81e72c8504fcd85 Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Wed, 1 Jul 2026 03:26:08 +0000
Subject: [PATCH] arm64: dts: aspeed: ast2700-dcscm: add sc18is606 SPI bridge

Upstream-Status: Inappropriate [board-specific]

---
 arch/arm64/boot/dts/aspeed/ast2700-dcscm.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/aspeed/ast2700-dcscm.dts b/arch/arm64/boot/dts/aspeed/ast2700-dcscm.dts
index 839c38cf5ab9..0137dfd9b2b2 100644
--- a/arch/arm64/boot/dts/aspeed/ast2700-dcscm.dts
+++ b/arch/arm64/boot/dts/aspeed/ast2700-dcscm.dts
@@ -893,6 +893,12 @@ &i2c4 {
 &i2c5 {
 	/* SMB_TMP_BMC */
 	status = "okay";
+
+	/* Mock sc18is606 for QEMU validation */
+	sc18is606@28 {
+		compatible = "nxp,sc18is606";
+		reg = <0x28>;
+	};
 };
 
 /* AST2700 i2c8 -> AST1060 i2c5 for PCH mailbox emulation test. */
